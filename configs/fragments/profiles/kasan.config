CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
# Shadow vmalloc/module allocations too (better UAF/OOB detection there). Costs more memory
# (acceptable here). Note: this does NOT silence the benign text_poke KASAN reports (verified on the
# live gate); those are why kasan_report is left opt-in rather than armed by default.
CONFIG_KASAN_VMALLOC=y
