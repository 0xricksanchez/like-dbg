CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# Don't treat compiler warnings as fatal. A bleeding-edge toolchain (e.g. clang 21 on an
# ubuntu:26.04 base) emits new warnings that the pinned older kernel (6.6.30) predates; with
# warnings-as-errors enabled those abort the build. This is a debug/exploitation kernel, so
# the strict setting buys us nothing here.
# CONFIG_WERROR is not set
