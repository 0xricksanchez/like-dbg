FROM like_dbg_base:latest
LABEL maintainer="Christopher Krah <mail@0x434b.dev>"

ENV DEBIAN_FRONTEND=noninteractive
ARG USER=user
WORKDIR /tmp

# debootstrap builds the rootfs; qemu-user-binfmt (pulls qemu-user) + binfmt-support enable
# foreign-arch (e.g. amd64-on-arm64) builds; e2fsprogs/perl/openssh-client are used by rootfs.sh
# (mkfs.ext4, crypt() for the user password, ssh-keygen).
#
# Ubuntu 26.04 dropped qemu-user-static: the static qemu-user binaries now live in qemu-user
# (pulled by qemu-user-binfmt) and are named `qemu-<arch>` without the historical `-static`
# suffix. rootfs.sh's foreign-arch debootstrap expects `qemu-<arch>-static` (binfmt suffix, the
# `which` check, and the copy into the chroot for `debootstrap --second-stage`), so recreate those
# names as HARDLINKS — same inode (no extra disk), and real files so the chroot copy duplicates
# actual binary content rather than a dangling symlink. Keeps rootfs.sh unchanged.
RUN apt-get update && \
    apt-get install -yq --no-install-recommends \
        debootstrap \
        qemu-user-binfmt \
        binfmt-support \
        e2fsprogs \
        perl \
        openssh-client && \
    for b in /usr/bin/qemu-*; do if [ -f "$b" ] && [ ! -e "$b-static" ]; then ln "$b" "$b-static"; fi; done && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /home/$USER
COPY io/scripts/rootfs.sh .
