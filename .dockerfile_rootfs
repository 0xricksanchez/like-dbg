FROM like_dbg_base:latest
LABEL maintainer="Christopher Krah <mail@0x434b.dev>"

ENV DEBIAN_FRONTEND=noninteractive
ARG USER=user
WORKDIR /tmp

# debootstrap builds the rootfs; qemu-user-static + binfmt-support enable foreign-arch
# (e.g. amd64-on-arm64) builds; e2fsprogs/perl/openssh-client are used by rootfs.sh
# (mkfs.ext4, crypt() for the user password, ssh-keygen).
RUN apt-get update && \
    apt-get install -yq --no-install-recommends \
        debootstrap \
        qemu-user-static \
        binfmt-support \
        e2fsprogs \
        perl \
        openssh-client && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /home/$USER
COPY io/scripts/rootfs.sh .
